# Copy this file to .env.local and fill in what you have.
# With nothing filled in, the app runs in DEMO MODE:
# a sample hotel, data kept in memory, and offline (rule-based) AI replies.

# --- AI (Claude) -------------------------------------------------------------
# Get a key at https://console.anthropic.com. Without it, the offline demo AI is used.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=

# --- Database (Supabase) -----------------------------------------------------
# Without these, data is kept in memory and resets when the server restarts.
SUPABASE_URL=
# Server-side only. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff inbox protection --------------------------------------------------
# If set, the staff inbox only works when opened as /dashboard/<hotel>?key=<this value>.
# Required before any real hotel pilot. Leave empty for local demos.
STAFF_ACCESS_KEY=
# Optional: this hotel's inbox stays open to everyone. Use ONLY for the fictional demo hotel.
PUBLIC_DEMO_HOTEL_SLUG=

# --- WhatsApp Cloud API (optional) -------------------------------------------
# From Meta for Developers > your app > WhatsApp > API Setup.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Which hotel (slug) answers this WhatsApp number.
WHATSAPP_HOTEL_SLUG=demo-madinah

# --- Public address ----------------------------------------------------------
# Used for canonical and language links on hotel websites. No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# --- Limits and privacy (optional; defaults shown) ---------------------------
# Requests per minute from one visitor to the guest chat and booking form.
RATE_LIMIT_PER_MINUTE=20
# After this many guest messages in 24 hours, the AI stops and staff take over.
MAX_GUEST_MESSAGES_PER_DAY=50
# Shown in the privacy notice. Apply it with public.purge_old_guest_data (docs/DEPLOY.md).
DATA_RETENTION_DAYS=90
BOOKING_RETENTION_DAYS=365
